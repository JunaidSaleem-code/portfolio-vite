# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# MongoDB Atlas connection string
MONGODB_URI=

# Cloudinary (server-side: signing uploads, deleting assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary (client-side: visible to browser, used by upload widget)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# NextAuth / Auth.js v5
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Admin user — used once by `npm run seed` to create the first admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend (contact form) — https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=
CONTACT_TO_EMAIL=         # where contact-form messages get delivered (defaults to ADMIN_EMAIL)
CONTACT_FROM_EMAIL=       # e.g. "Portfolio <hello@yourdomain.com>" — must be a verified Resend sender
